# ============================================================
# TEMPLATE .env.production — salin ke deploy/.env.production lalu isi nilai asli.
# deploy/.env.production DI-IGNORE dari git (tidak pernah di-commit ke repo public).
# ----------------------------------------------------------------------------
# Cara pakai:
#   cp .env.production.example .env.production
#   (edit semua nilai CHANGE_ME dengan nilai rahasia asli milikmu)
# Nilai rahasia disimpan TERPISAH (password manager / env server), bukan di git.
# ============================================================

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=24h

# Webhook Wazuh -> backend (digunakan juga oleh custom-wazuh.py / ossec.conf)
WEBHOOK_API_KEY=CHANGE_ME

# CORS (origin aplikasi web Flutter)
CORS_ORIGIN=https://siemkampus-monitoring-app.duckdns.org

# pgAdmin
PGADMIN_EMAIL=admin@siemkampus.id
PGADMIN_PASSWORD=CHANGE_ME

# Firebase (file firebase-service-account.json ditaruh di deploy/ — DI-IGNORE)
# FCM_CREDENTIALS_PATH diatur di docker-compose.prod.yml
