PORT=3000

# Dev (local): docker compose up postgres -d
# DATABASE_URL="postgresql://wazuh:wazuh123@localhost:5432/wazuh_monitor?schema=public"

# Production (Docker Compose): uses postgres service name
DATABASE_URL="postgresql://wazuh:wazuh123@postgres:5432/wazuh_monitor?schema=public"

JWT_SECRET="change-this-to-a-random-secret"
JWT_EXPIRES_IN="24h"
WEBHOOK_API_KEY="change-this-webhook-api-key"
FCM_CREDENTIALS_PATH="./firebase-service-account.json"

# Comma-separated origins (e.g. http://localhost:3000,https://app.example.com)
CORS_ORIGIN="*"
